{
  "expo": {
    "name": "鍋巴 GOBA",
    "slug": "caramel",
    "scheme": "goba",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mmlovenn.goba",
      "infoPlist": {
        "CFBundleDisplayName": "鍋巴 GOBA",
        "NSLocationWhenInUseUsageDescription": "鍋巴 GOBA 需要取用您的位置，以提供即時導航、所在地區天氣與附近加油站／停車場資訊。",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "鍋巴 GOBA 在導航進行中需要背景位置權限，以確保切換畫面或鎖屏時仍能持續提供語音轉彎指引與偏航重算。",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.mmlovenn.goba",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FCE7F3"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1d9fa917-f3f5-4f93-8ae6-581e46b0da7a"
      }
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "@maplibre/maplibre-react-native"
    ]
  }
}
